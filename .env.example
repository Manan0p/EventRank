# Copy this file to .env.local for a configured deployment. Leave the
# credentials blank to run the UI with the explicit demo-mode fallback.

# Neon Postgres (production persistence boundary)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js / NextAuth JWT signing secret. Use a long random value in production.
AUTH_SECRET=replace-with-a-long-random-session-secret
# NEXTAUTH_SECRET is accepted as a compatibility alias for older deployments.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth. Leave blank in demo mode.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# College and feature policy
COLLEGE_DOMAIN=northbridge.edu
ENFORCE_COLLEGE_DOMAIN=false
DEMO_MODE=true

# Optional semantic-search boundary. Keyword discovery remains the fallback.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
SEMANTIC_SEARCH_ENABLED=false

# Optional deterministic clock for demos and tests (ISO-8601).
DEMO_NOW=

# Public URL used for links and OAuth callback configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
